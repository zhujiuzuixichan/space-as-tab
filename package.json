{
  "name": "space-as-tab",
  "version": "1.1.0",
  "description": "Obsidian plugin: disable auto-converting typed spaces to Tab, so spaces stay spaces. 屏蔽「输入空格自动转 Tab」，让空格保持空格。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "tab",
    "indent",
    "space"
  ],
  "author": "Mu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhujiuzuixichan/space-as-tab.git"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
